# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenCode UI — temp / creds / root src/assets & public (keeps .opencode-deployrc.json, domains, server-config.json)
.opencode-deploy-input
.opencode-deploy-cli-result.json
.opencode-deploy-cli-stage*
.opencode-deploy-config-*
.opencode-deploy-secrets-*
.opencode-deploy-prefs-*
.opencode-server-deploy-creds.json
opencode-deploy-cli-verify
.opencode-host-write/
.opencode-preview-select/
.opencode-gpsh-out
.opencode-gpsh-err
.opencode-github-token-out
.opencode-github-token-err
.gpsh_token
.opencode-ui-upgrade-result
/src/assets/
/public/
